# Openlytic frontend environment (copy to .env.local)
# Next.js inlines NEXT_PUBLIC_* at build time.

# Openlytic Backend.API.Server base URL (REST /auth/* + /organization + /graphql)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Openlytic email consumer tracking base URL (open/click pixel + link rewrites)
NEXT_PUBLIC_TRACKING_URL=http://localhost:9000